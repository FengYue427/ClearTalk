{
  "name": "cleartalk",
  "version": "1.0.0",
  "description": "AI驱动的沟通文本生成助手",
  "type": "module",
  "scripts": {
    "dev": "npx vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:all": "concurrently -k -n backend,web -c blue,green \"npm run dev:backend\" \"npm run dev\"",
    "build": "npx vite build",
    "vercel-build": "npm run scenes:build && npm run build",
    "preview": "npx vite preview",
    "scenes:build": "node scripts/merge-field-label-en.mjs && node scripts/extract-scenes.mjs --from-json && node scripts/sync-scene-i18n.mjs",
    "scenes:flutter": "node scripts/build-flutter-scenes.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "test": "npx vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "check:production": "node scripts/check-production-config.mjs",
    "launch:verify": "node scripts/launch-verify.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "verify:production": "node scripts/verify-production-api.mjs",
    "audit": "node scripts/final-audit.mjs",
    "i18n:audit": "node scripts/audit-i18n-keys.mjs",
    "legal:sync": "node scripts/sync-legal-html.mjs",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@vitejs/plugin-legacy": "^5.3.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.5",
    "terser": "^5.30.0",
    "vite": "^5.2.0",
    "vite-plugin-pwa": "^0.19.8",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "workbox-window": "^7.1.0"
  },
  "keywords": [
    "ai",
    "communication",
    "text-generator",
    "pwa"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
