# Deepseek API Key
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI（可选，用于 gpt-4o 等模型）
OPENAI_API_KEY=

# 通义千问 / DashScope（可选，用于 qwen-turbo）
QWEN_API_KEY=

# 默认 AI 供应商：deepseek | openai | qwen
DEFAULT_AI_PROVIDER=deepseek

# 服务器端口
PORT=3000

# 允许的域名（多个用逗号分隔，* 表示允许所有）
# 生产环境建议设置为你的前端域名
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 请求频率限制：每 IP 每 15 分钟最大请求数
RATE_LIMIT_MAX=30

# Node 环境
NODE_ENV=development

# ============================================
# 邮箱服务配置（用于发送验证码和重置密码邮件）
# ============================================
# 如果使用 Gmail:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password (不是邮箱密码，是应用专用密码)

# 如果使用 QQ 邮箱:
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=587
# EMAIL_USER=your-qq@qq.com
# EMAIL_PASS=your-auth-code (授权码，不是邮箱密码)

# 如果使用 163 邮箱:
# EMAIL_HOST=smtp.163.com
# EMAIL_PORT=465
# EMAIL_USER=your-email@163.com
# EMAIL_PASS=your-auth-code

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Render 推荐：Resend HTTP API（163/QQ SMTP 在海外机房常 ETIMEDOUT）
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=ClearTalk <onboarding@resend.dev>

# 前端 URL（用于密码重置链接，格式：https://你的站点.vercel.app）
FRONTEND_URL=http://localhost:8080

# 仅开发：生产环境若未配 SMTP，设为 1 可在 API 响应中返回验证码（正式对外勿开启）
# ALLOW_DEV_EMAIL_PREVIEW=0

# JWT 密钥（生产环境请修改）
JWT_SECRET=your-secret-key-change-in-production

# 反馈统计接口密钥（GET /api/feedback/stats）
FEEDBACK_ADMIN_KEY=change-me-in-production

# 反馈存储上限、限流
FEEDBACK_STORE_MAX=2000
FEEDBACK_RATE_LIMIT_MAX=20

# SQLite 数据库路径（默认 backend/data/cleartalk.db）
SQLITE_PATH=

# 埋点限流（每 IP 15 分钟）
EVENTS_RATE_LIMIT_MAX=60

# 每日 AI 生成配额（按用户 ID 或 IP）
FREE_DAILY_GENERATIONS=20
PRO_DAILY_GENERATIONS=200
# 逗号分隔的 Pro 用户 ID（无支付网关时的白名单）
PRO_USER_IDS=

# 粘贴 AI 分类限流（每 IP 15 分钟）
CLASSIFY_RATE_LIMIT_MAX=15
