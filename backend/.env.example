# Deepseek API Key
# 从 https://platform.deepseek.com/ 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 服务器端口
PORT=3000

# 允许的域名（多个用逗号分隔，* 表示允许所有）
# 生产环境建议设置为你的前端域名
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# 请求频率限制：每 IP 每 15 分钟最大请求数
RATE_LIMIT_MAX=30

# Node 环境
NODE_ENV=development

# ============================================
# 邮箱服务配置（用于发送验证码和重置密码邮件）
# ============================================
# 如果使用 Gmail:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-password (不是邮箱密码，是应用专用密码)

# 如果使用 QQ 邮箱:
# EMAIL_HOST=smtp.qq.com
# EMAIL_PORT=587
# EMAIL_USER=your-qq@qq.com
# EMAIL_PASS=your-auth-code (授权码，不是邮箱密码)

# 如果使用 163 邮箱:
# EMAIL_HOST=smtp.163.com
# EMAIL_PORT=465
# EMAIL_USER=your-email@163.com
# EMAIL_PASS=your-auth-code

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# 前端 URL（用于密码重置链接）
FRONTEND_URL=http://localhost:8080

# JWT 密钥（生产环境请修改）
JWT_SECRET=your-secret-key-change-in-production
